# Ignorar pasta de imagens de produtos
/imagens/*
!/imagens/.gitkeep

# Ignorar arquivos de configuração sensíveis (opcional, se quiser esconder o db.php)
# db.php
.env
.env.*
!.env.example

# Cópia local do mesmo projeto; não deve ser versionada dentro dela mesma.
/toa-toa-telas/

# Ignorar arquivos do Sistema Operacional
Thumbs.db
.DS_Store

# Estado local, logs, backups e pacotes temporários do atualizador.
/storage/
/releases/*.zip
