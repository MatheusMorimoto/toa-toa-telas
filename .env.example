# Copie para .env e preencha localmente. Nunca versione valores reais.
APP_AUTH_ENABLED=false
APP_AUTH_USER=admin
APP_AUTH_PASSWORD_HASH=$2y$10$substitua_por_um_hash_gerado_com_password_hash
DB_HOST=db.seu-projeto.supabase.co
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres
MYSQL_HOST=localhost
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=produtos_cadastrados
API_BASE_URL=https://api-toa-a-toa-2.onrender.com
# Use o mesmo valor de CHAVE_MESTRA configurado no Render.
TOA_TOA_API_KEY=
UPDATER_REPO_OWNER=MatheusMorimoto
UPDATER_REPO_NAME=toa-toa-telas
UPDATER_BRANCH=main
UPDATER_MANIFEST_URL=https://raw.githubusercontent.com/MatheusMorimoto/toa-toa-telas/main/version.json
UPDATER_CHECK_INTERVAL=300
APP_RUNTIME_VERSION=1.0.0
# URL HTTPS pública onde este projeto PHP está hospedado, sem barra no final.
PUBLIC_APP_URL=https://catalogo.seudominio.com
# Número com código do país e DDD, somente dígitos. Exemplo: 5565999999999
WHATSAPP_BUSINESS_NUMBER=
